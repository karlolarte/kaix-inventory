# Get it from your Neon project dashboard: https://console.neon.tech
# Use the pooled ("-pooler") connection string — this app runs as Vercel
# serverless functions, which need a pooled connection to avoid exhausting
# Postgres connections under concurrent invocations.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Powers the AI dashboard chat (src/server/services/AIChatService.ts).
ANTHROPIC_API_KEY=""
# Optional — defaults to "claude-sonnet-5" if unset.
# ANTHROPIC_MODEL="claude-sonnet-5"

# Auth — signs/verifies the access_token cookie. Generate via:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every existing login session.
JWT_SECRET=""

# Seeded admin account (prisma/seed.ts) — optional, only used by `npm run db:seed`.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_PIN=""
